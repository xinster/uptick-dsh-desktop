{
  "name": "dsh-desktop-shell",
  "productName": "DeepSeek Harness Desktop",
  "version": "1.1.0",
  "description": "DeepSeek Harness 官方 Web UI 的精美桌面壳：自动启动本地服务、托盘常驻、一键访问",
  "main": "main.js",
  "author": "DSH Desktop Shell",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test --no-sandbox --disable-gpu",
    "pack": "electron-packager . DeepSeekHarnessDesktop --platform=darwin --arch=arm64 --overwrite --asar --app-bundle-id=com.dsh.shell --app-version=1.0.0 --icon=assets/icon.icns --out=dist --download.cacheRoot=.electron-cache --ignore=\"^/(\\.electron-cache|npm-cache|\\.user-data|scripts|dist)(/|$)\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2"
  }
}
